class Unsupported(RuntimeError):
    pass


class Transient(RuntimeError):
    pass


class UnsafeRecovery(RuntimeError):
    pass


class AwaitingPlacement(Transient):
    pass


def log(message):
    print(message, flush=True)


def pump():
    context = GLib.MainContext.default()
    while context.pending():
        context.iteration(False)


def wait_until(check, description, timeout=6):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pump()
        if result := check():
            return result
        time.sleep(0.025)
    raise Transient(f"Timed out waiting for {description}.")


def atomic_write(path, data, mode=0o600):
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=f".{path.name}.", delete=False) as temp:
        tmp = Path(temp.name)
        try:
            os.fchmod(temp.fileno(), mode)
            temp.write(data)
            temp.flush()
            os.fsync(temp.fileno())
            os.replace(tmp, path)
            sync_directory(path.parent)
        finally:
            tmp.unlink(missing_ok=True)


def sync_directory(directory):
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def open_owned(path, flags=os.O_RDONLY):
    try:
        fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise UnsafeRecovery(f"{path.name} is a symlink. Refusing to follow it.") from error
        raise
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
        os.close(fd)
        raise UnsafeRecovery(f"{path.name} is not a regular, privately owned file.")
    return fd, info


def read_json(path):
    try:
        fd, _ = open_owned(path)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, encoding="utf-8") as stream:
        return json.load(stream)


def write_json(path, value):
    atomic_write(path, json.dumps(value, sort_keys=True).encode("utf-8"))


def parse_metadata(data):
    config = configparser.ConfigParser(interpolation=None, delimiters=("=",))
    config.optionxform = str
    config.read_string(data.decode("utf-8"))
    return config


def patch_metadata(data, updates):
    """Replace only the existing keys selected by the plan."""
    remaining = updates.copy()
    group = None
    lines = []
    for line in data.decode("utf-8").splitlines(keepends=True):
        if header := re.fullmatch(r"\s*\[(.*)\]\s*", line):
            group = header.group(1)
        if entry := re.fullmatch(r"([ \t]*[^=\s#;]+[ \t]*=[ \t]*)([^\r\n]*?)([ \t]*\r?\n?)", line):
            key = (group, entry[1].partition("=")[0].strip())
            if key in remaining:
                line = entry[1] + remaining.pop(key) + entry[3]
        lines.append(line)
    if remaining:
        raise Unsupported(f"Cannot find exact lines for {tuple(remaining)}.")
    return "".join(lines).encode("utf-8")


@dataclass(frozen=True)
class Axis:
    adjust: int
    pitch: int
    origin: int
    count: int

    @classmethod
    def for_area(cls, length, adjust, axis, vertical_offset):
        pitch = int((130 if axis == 0 else 100) * (adjust / 100.0))
        inset = pitch // 2 - 24 if axis == 0 else max(0, pitch // 2 - vertical_offset)
        return cls(adjust, pitch, (length % pitch) // 2 + inset, length // pitch)

    def pixel(self, cell):
        return self.origin + cell * self.pitch

    def cell(self, pixel):
        index = round((pixel - self.origin) / self.pitch)
        if not 0 <= index < self.count or abs(self.pixel(index) - pixel) >= self.pitch / 2:
            raise Unsupported(f"Saved coordinate {pixel} does not identify a unique cell (origin {self.origin}, pitch {self.pitch}).")
        return index


def slot_pixel(axis, index, inset):
    limit = axis.pitch // 2 - 1
    return max(0, axis.pixel(index) + max(-limit, min(limit, inset)))


@dataclass(frozen=True)
class AxisChoice:
    grid: Axis
    leading: int
    trailing: int
    margin_shortfall: int
    pitch_shortfall: int
    overlaps: int
    outer_cost: int
    pitch_cost: int

    @property
    def adjust(self):
        return self.grid.adjust


@lru_cache(maxsize=256)
def axis_candidates(length, axis, offset, target_margin, min_margin, min_label,
                    target_pitch, min_pitch, preferred_max, footprints, row_reserve=0):
    low = 50 if axis == 0 else 75
    result = []
    for adjust in range(low, 201):
        grid = Axis.for_area(length, adjust, axis, offset)
        if grid.pitch < row_reserve or not grid.count or any(index >= grid.count for index, *_ in footprints):
            continue
        intervals = []
        for index, inset, before, after in footprints:
            planned = slot_pixel(grid, index, inset)
            nominal = grid.pixel(index)
            intervals.append((min(planned, nominal) - before, max(planned, nominal) + after))
        leading = min((left for left, _ in intervals), default=length)
        trailing = length - max((right for _, right in intervals), default=0)
        if min(leading, trailing) < 0:
            continue
        mask = bit = 0
        for i, (left, right) in enumerate(intervals):
            for other_left, other_right in intervals[i+1:]:
                # The bottom 6 px are selection highlight, not label ink.
                highlight = 6 if axis == 1 else 0
                if left < other_right - highlight and other_left < right - highlight:
                    mask |= 1 << bit
                bit += 1
        origin = grid.origin
        margin_shortfall = max(0, min_margin - origin) + max(0, min_label - min(leading, trailing))
        band = max(0, target_margin - 5 - origin, origin - target_margin - 10)
        outer = abs(origin - target_margin) + 3 * band + 2 * max(0, grid.pitch - preferred_max)
        result.append(AxisChoice(grid, leading, trailing, margin_shortfall,
                                 max(0, min_pitch - grid.pitch), mask, outer,
                                 abs(grid.pitch - target_pitch)))
    return tuple(sorted(result, key=lambda item: (item.margin_shortfall, item.pitch_shortfall, item.outer_cost)))


def layout_score(x, y, label_height):
    mismatch = abs(x.grid.origin - y.grid.origin)
    outer = x.outer_cost + y.outer_cost + mismatch + 4 * max(0, mismatch - 3)
    # Eighth-pixel units avoid floating point ties. Whitespace is scored only
    # after pitch, so its proportional targets cannot pull the grid apart.
    common_twice = x.grid.origin + y.grid.origin
    whitespace = (abs(8 * (x.grid.pitch - 48) - 5 * common_twice)
                  + abs(8 * (y.grid.pitch - label_height) - 2 * common_twice))
    return (x.margin_shortfall + y.margin_shortfall, x.pitch_shortfall + y.pitch_shortfall,
            outer, x.pitch_cost + y.pitch_cost, whitespace)


def two_line_row_pitch(single_line_height):
    line_height = single_line_height - 48 - 2
    return single_line_height + line_height + 6


def best_layout(width, height, offset, label_height, args, current, footprints):
    row_reserve = two_line_row_pitch(label_height)
    axes = [
        axis_candidates(length, i, offset, args.margin[i], args.min_margin[i],
                        args.min_label_clearance, args.pitch[i], args.min_pitch[i],
                        args.preferred_max_pitch[i], tuple(footprints[i]),
                        row_reserve if i == 1 else 0)
        for i, length in enumerate((width, height))
    ]
    if not axes[1]:
        raise Unsupported(f"No grid fits the saved rows with {row_reserve} px reserved for two-line labels.")
    if not axes[0]:
        raise Unsupported("No grid fits the saved columns and label bounds within the work area.")

    def score(x, y):
        movement = abs(x.adjust - current[0]) + abs(y.adjust - current[1])
        return (*layout_score(x, y, label_height), movement, x.adjust, y.adjust)

    best = winner = None
    for x in axes[0]:
        for y in axes[1]:
            lower = (x.margin_shortfall + y.margin_shortfall, x.pitch_shortfall + y.pitch_shortfall,
                     x.outer_cost + y.outer_cost)
            if best is not None and lower > best[:3]:
                break
            if x.overlaps & y.overlaps:
                continue
            value = score(x, y)
            if best is None or value < best:
                best, winner = value, (x, y)
    if winner is None:
        raise Unsupported("No grid fits the saved icons without estimated overlap.")

    existing = [next((item for item in options if item.adjust == adjust), None)
                for options, adjust in zip(axes, current)]
    if args.hysteresis and all(existing) and not existing[0].overlaps & existing[1].overlaps:
        previous = score(*existing)
        if (previous[0] == best[0] == 0 and previous[1] == best[1]
                and abs(existing[0].grid.origin - existing[1].grid.origin)
                    <= abs(winner[0].grid.origin - winner[1].grid.origin) + args.hysteresis
                and previous[2] <= best[2] + 5 * args.hysteresis
                and previous[3] <= best[3] + 2 * args.hysteresis):
            return existing
    return winner


def adjustment(config):
    raw = config.get(GROUP, ADJUST, fallback="")
    match = re.fullmatch(r"(\d+);(\d+);", raw)
    if not match:
        raise Unsupported("Set Nemo's per-monitor spacing once before using this prototype.")
    h, v = map(int, match.groups())
    if not (50 <= h <= 200 and 75 <= v <= 200):
        raise Unsupported(f"Unsupported saved spacing {h};{v}.")
    return h, v


class Desktop:
    def __init__(self):
        if os.geteuid() == 0:
            raise Unsupported("Run as the Cinnamon desktop user.")
        if os.environ.get("XDG_SESSION_TYPE") != "x11":
            raise Unsupported("An X11 desktop session is required.")
        self.display = Gdk.Display.get_default()
        if self.display is None or type(self.display).__name__ != "X11Display":
            raise Unsupported("GTK is not connected to X11.")
        self.settings = Gio.Settings.new("org.nemo.desktop")
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.volume_monitor = Gio.VolumeMonitor.get()
        self.mount_labels = {}
        self.ending = False
        self.label = Gtk.Label()
        self.journal = STATE / "transaction.json"
        self.checkpoint = STATE / "grid.json"

    def call(self, dest, path, interface, method, params=None):
        return self.bus.call_sync(dest, path, interface, method, params, None,
                                  Gio.DBusCallFlags.NONE, 1200, None).unpack()

    def session(self, method, params=None):
        return self.call(SESSION, SESSION_PATH, SESSION, method, params)

    def check_session(self):
        if self.ending:
            raise Unsupported("The graphical session is ending.")
        if not self.session("IsSessionRunning")[0]:
            raise Unsupported("Cinnamon is not in its running session phase.")
        if not self.session("IsAutostartConditionHandled", GLib.Variant("(s)", (CONDITION,)))[0]:
            raise Unsupported("Cinnamon does not manage Nemo through its native autostart condition.")
        if not self.settings.is_writable(SETTING):
            raise Unsupported("Nemo's desktop icon setting is locked.")

    def compositor_owner(self):
        try:
            return self.call(DBUS, "/org/freedesktop/DBus", DBUS, "GetNameOwner",
                             GLib.Variant("(s)", (COMPOSITOR,)))[0]
        except GLib.Error as error:
            if (Gio.DBusError.get_remote_error(error) or "").endswith(".NameHasNoOwner"):
                return None
            raise

    def require_compositor(self, expected=None):
        owner = self.compositor_owner()
        if self.ending or not owner or (expected is not None and owner != expected):
            raise Transient("Cinnamon is recovering. Waiting for a stable compositor.")
        return owner

    def owner_pid(self):
        try:
            return self.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                             "GetConnectionUnixProcessID", GLib.Variant("(s)", (DESKTOP,)))[0]
        except GLib.Error as error:
            if (Gio.DBusError.get_remote_error(error) or "").endswith(".NameHasNoOwner"):
                return None
            raise

    def client_pid(self):
        interface = SESSION + ".Client"
        for path in self.session("GetClients")[0]:
            try:
                if self.call(SESSION, path, interface, "GetAppId")[0] == "nemo-autostart.desktop":
                    return self.call(SESSION, path, interface, "GetUnixProcessId")[0]
            except GLib.Error as error:
                if not (Gio.DBusError.get_remote_error(error) or "").endswith(".UnknownMethod"):
                    raise
        return None

    def mapped_pid(self):
        pid = self.owner_pid()
        if pid is None or self.client_pid() != pid:
            return None
        window = subprocess.run(["xwininfo", "-name", "Desktop"], capture_output=True,
                                text=True, timeout=2)
        if "Map State: IsViewable" in window.stdout:
            return pid
        return None

    def set_enabled(self, enabled):
        if not self.settings.set_boolean(SETTING, enabled):
            raise RuntimeError(f"Cinnamon rejected {SETTING}={enabled}.")
        Gio.Settings.sync()

    def area(self):
        if self.display.get_n_monitors() != 1:
            raise Unsupported("Exactly one active monitor is required.")
        monitor = self.display.get_monitor(0)
        screen, work = monitor.get_geometry(), monitor.get_workarea()
        if (monitor.get_scale_factor() != 1 or screen.x or screen.y or work.x or work.y
                or not 1 <= work.width <= screen.width or not 1 <= work.height <= screen.height):
            raise Unsupported("Only scale-1 layouts with a top-left work-area origin are supported.")
        return monitor.get_model(), work.width, work.height

    def verify_randr(self):
        result = subprocess.run(["xrandr", "--listactivemonitors"], capture_output=True,
                                check=True, text=True, timeout=2)
        lines = result.stdout.splitlines()
        if not lines or lines[0].strip() != "Monitors: 1" or len(lines) != 2 or len(lines[1].split()) != 4:
            raise Unsupported("The RandR layout has multiple or cloned outputs.")

    def pointer_dragging(self):
        window = self.display.get_default_screen().get_root_window()
        pointer = self.display.get_default_seat().get_pointer()
        return bool(window.get_device_position(pointer).mask & Gdk.ModifierType.BUTTON1_MASK)

    def check_icons(self):
        if not self.settings.get_boolean("use-desktop-grid"):
            raise Unsupported("Nemo's modern grid is disabled.")
        if self.settings.get_string("desktop-layout").split("::")[0] != "true":
            raise Unsupported("Nemo is not configured to draw icons on the primary monitor.")

    def mount_groups(self):
        self.mount_labels.clear()
        if not self.settings.get_boolean("volumes-visible"):
            return {}
        groups = {}
        for mount in self.volume_monitor.get_mounts():
            if mount.is_shadowed():
                continue
            volume = mount.get_volume()
            name = volume.get_name() if volume else mount.get_name()
            group = name.replace("/", "-") + ".volume"
            if group in groups:
                raise Unsupported("More than one mount has the same Nemo metadata name.")
            # Keep the identity stable across desktop restarts without storing URIs.
            self.mount_labels[group] = mount.get_name()
            root_uri = mount.get_root().get_uri()
            groups[group] = hashlib.sha256(root_uri.encode("utf-8")).hexdigest()
        return groups

    def desktop_directory(self):
        prefs = Gio.Settings.new("org.nemo.preferences")
        directory = (str(Path.home()) if prefs.get_boolean("desktop-is-home-dir")
                     else GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP))
        if not directory or not Path(directory).is_dir():
            raise Unsupported("Cannot find Nemo's desktop folder.")
        return Path(directory)

    def file_icons(self):
        root = self.desktop_directory()
        hidden = set()
        hidden_file = root / ".hidden"
        if hidden_file.is_file():
            hidden = set(hidden_file.read_text(encoding="utf-8").splitlines())
        result = {}
        for path in sorted(root.iterdir()):
            if path.name.startswith(".") or path.name.endswith("~") or path.name in hidden:
                continue
            entry = read_file_icon(path)
            if entry is not None:
                result["file:" + str(path)] = entry
        return result

    def label_layout(self, text):
        layout = self.label.create_pango_layout(text)
        font = self.settings.get_string("font")
        if font:
            layout.set_font_description(Pango.FontDescription.from_string(font))
        return layout

    def label_footprint(self, key):
        kind, name = key.split(":", 1)
        if kind == "file":
            names = [Path(name).name]
            if name.endswith(".desktop"):
                app = Gio.DesktopAppInfo.new_from_filename(name)
                if app and app.get_display_name():
                    names.append(app.get_display_name())
        elif name in ICONS:
            labels = dict(computer="Computer", home="Home", trash="Trash", network="Network Servers")
            names = [gettext.dgettext("nemo", labels[name])]
        else:
            names = [self.mount_labels.get(name, name.removesuffix(".volume"))]

        # Nemo 6.4 uses a fixed 110 px Normal label width, centered beneath
        # the image, and adds 8 px of horizontal highlight padding.
        width, height = 0, 0
        lines = max(1, self.settings.get_int("text-ellipsis-limit"))
        line_height = self.label_layout("Test").get_pixel_size()[1]
        for label in names:
            layout = self.label_layout(label)
            layout.set_width(110 * Pango.SCALE)
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            width = max(width, min(110, layout.get_pixel_size()[0]) + 8)
            height = max(height, min(lines, layout.get_line_count()) * line_height)
        left = max(0, width // 2 - 24)
        right = max(48, 24 + (width + 1) // 2)
        return (left, right), (0, 48 + height + 8)

    def vertical_offset(self):
        lines = self.settings.get_int("text-ellipsis-limit")
        return (lines * self.label_layout("Test").get_pixel_size()[1] + 48 + 4 + 1) // 2

    def read(self):
        fd, info = open_owned(METADATA)
        with os.fdopen(fd, "rb") as stream:
            return stream.read(), stat.S_IMODE(info.st_mode)

    def recover(self):
        try:
            pending = read_json(self.journal)
        except ValueError as error:
            raise UnsafeRecovery("The recovery journal is unreadable. Keeping it for review.") from error
        if pending is None and not self.journal.exists():
            return
        if not isinstance(pending, dict) or not pending:
            raise UnsafeRecovery("The recovery journal has an invalid structure. Keeping it for review.")
        self.check_session()
        phase = pending.get("visibility", "held")
        if phase not in ("prepared", "held", "released"):
            raise UnsafeRecovery("Unknown visibility phase. Keeping the recovery journal.")
        initializing = pending.get("initialization", False)
        restore = not initializing or pending.get("restore_icons") is True
        try:
            if initializing:
                recover_initialization(self, pending, phase)
            else:
                owner = self.require_compositor()
                log("Recovering the previous grid transaction.")
                expected = self.reconcile_layout(pending, owner, phase)
        finally:
            if restore and (phase == "held" or pending.get("visibility") == "held"):
                release_visibility(self, pending)
        if self.ending:
            return
        if initializing or phase == "prepared":
            forget_journal(self)
            return
        if self.settings.get_boolean(SETTING):
            await_desktop(self, "the recovered desktop window", owner)
        self.require_compositor(owner)
        checkpoint = pending[expected]
        verify_layout(self, checkpoint)
        write_json(self.checkpoint, checkpoint)
        forget_journal(self)

    def reconcile_layout(self, pending, owner, phase):
        position_repair = pending.get("position_repair")
        validate_recovery_files(self, pending)
        data, _ = self.read()
        expected = recovery_side(pending, data, position_repair)
        if phase == "prepared":
            if expected != "old":
                raise UnsafeRecovery("The grid changed before the transaction began. Keeping the journal.")
            return expected
        validate_layout_record(pending[expected])
        group_write = position_repair and recover_icon_positions(parse_metadata(data), position_repair, expected)
        file_write = any(needs_recovery_write(change, expected == "new")
                         for change in pending.get("files", []))
        if file_write or group_write:
            pid = self.owner_pid() or self.client_pid()
            if self.settings.get_boolean(SETTING) and pid:
                hold_visibility(self, pending)
            wait_until(lambda: not self.owner_pid() and not self.client_pid()
                       and process_exited(pid), "Cinnamon to stop Nemo Desktop for recovery")
            self.require_compositor(owner)
            latest, mode = self.read()
            if recovery_side(pending, latest, position_repair) != expected:
                raise UnsafeRecovery("The grid changed during recovery. Keeping the journal.")
            if position_repair:
                repairs = recover_icon_positions(parse_metadata(latest), position_repair, expected)
                if repairs:
                    atomic_write(METADATA, patch_metadata(latest, repairs), mode)
            for change in pending.get("files", []):
                file_update(change, expected == "new", recover=True)
        return expected



GIO_POSITION = "metadata::" + POSITION
GIO_ATTRIBUTES = "standard::is-hidden,standard::is-backup,metadata::monitor,metadata::icon-scale," + GIO_POSITION


def file_identity(path):
    info = path.lstat()
    return [info.st_dev, info.st_ino, info.st_ctime_ns]


def read_file_icon(path):
    identity = file_identity(path)
    file = Gio.File.new_for_path(str(path))
    info = file.query_info(GIO_ATTRIBUTES, Gio.FileQueryInfoFlags.NONE, None)
    if info.get_is_hidden() or info.get_is_backup():
        return None
    return {"position": info.get_attribute_string(GIO_POSITION),
            "monitor": info.get_attribute_string("metadata::monitor"),
            "scale": info.get_attribute_string("metadata::icon-scale"),
            "identity": identity}


def file_update(change, commit, recover=False):
    path = Path(change["path"])
    try:
        info = read_file_icon(path)
    except FileNotFoundError:
        info = None
    except GLib.Error as error:
        if not error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_FOUND):
            raise
        info = None
    if info is None or info["identity"] != change["identity"]:
        if recover:
            log(f"Skipping removed, renamed, or replaced desktop file: {path.name!r}")
            return
        raise Unsupported(f"Desktop file changed during the transaction: {path.name!r}.")
    position = info["position"]
    old, new = change["old"], change["new"]
    if position not in (old, new):
        if recover:
            log(f"Keeping a newer desktop position for {path.name!r}.")
            return
        raise Unsupported(f"Desktop file position changed during the transaction: {path.name!r}.")
    target = new if commit else old
    if position == target:
        return
    file = Gio.File.new_for_path(str(path))
    if not file.set_attribute_string(GIO_POSITION, target, Gio.FileQueryInfoFlags.NONE, None):
        raise RuntimeError(f"GVfs rejected the desktop position for {path.name!r}.")
    updated = read_file_icon(path)
    if not updated or updated["identity"] != change["identity"] or updated["position"] != target:
        raise RuntimeError(f"GVfs did not retain the desktop position for {path.name!r}.")



def grid_record(area, adjustments, offset):
    return {"area": list(area), "adjust": list(adjustments), "offset": offset}


def collect_cells(desktop, args, area, data):
    config = parse_metadata(data)
    if any(group.startswith("desktop-monitor-") and group != GROUP for group in config.sections()):
        raise Unsupported("Nemo metadata contains additional monitor groups.")
    if (config.getboolean(GROUP, "nemo-icon-view-auto-layout", fallback=True)
            or not config.getboolean(GROUP, "nemo-icon-view-keep-aligned", fallback=False)
            or config.getint(GROUP, "nemo-icon-view-zoom-level", fallback=-1) != 3):
        raise Unsupported("Require Auto-arrange off, Align to grid on and explicit Normal icon size (zoom 3).")
    current = adjustment(config)
    offset = desktop.vertical_offset()
    previous = read_json(desktop.checkpoint)
    old_area, old_offset, old_cells = area, offset, {}
    resize = False
    if args.old_area:
        old_area = area[0], *args.old_area
    elif previous and previous["area"][0] == area[0] and tuple(previous["adjust"]) == current:
        old_area, old_offset = tuple(previous["area"]), previous["offset"]
        old_cells = previous.get("cells", {})
        resize = (getattr(args, "watch", False)
                  and tuple(previous.get("observed_area", previous["area"])) != area)
    old_axes = [Axis.for_area(length, adjust, i, old_offset)
                for i, (length, adjust) in enumerate(zip(old_area[1:], current))]
    current_axes = [Axis.for_area(length, adjust, i, offset)
                    for i, (length, adjust) in enumerate(zip(area[1:], current))]

    groups = [icon for icon in ICONS if desktop.settings.get_boolean(f"{icon}-icon-visible")]
    mounts = desktop.mount_groups()
    groups.extend(mounts)
    entries = desktop.file_icons()
    for group in groups:
        entries["group:" + group] = {
            "position": config.get(group, POSITION, fallback=None),
            "monitor": config.get(group, "monitor", fallback=None),
            "scale": config.get(group, "icon-scale", fallback="1"),
            "identity": mounts.get(group),
        }

    icons = {}
    occupied = {}
    for key, entry in entries.items():
        name = icon_name(key)
        point = re.fullmatch(r"(\d+),\s*(\d+)", entry["position"] or "")
        if not point:
            raise AwaitingPlacement(f"{name!r} has no saved Nemo position yet.")
        if entry["monitor"] not in ("0", "-1", None) or float(entry["scale"] or 1) != 1.0:
            raise Unsupported(f"{name!r} has an unsupported monitor or icon scale.")
        xy = tuple(map(int, point.groups()))
        saved = old_cells.get(key)
        if (saved and saved.get("identity") == entry["identity"]
                and (resize or saved["xy"] == list(xy))):
            cell, inset = tuple(saved["cell"]), tuple(saved["inset"])
        else:
            # Nemo can re-align icons after a resize even in manual mode.
            # Use the geometry whose slot best fits the saved anchor.
            candidates = []
            for reference in (old_axes,) if args.old_area else (old_axes, current_axes):
                try:
                    indexes = tuple(axis.cell(pixel) for axis, pixel in zip(reference, xy))
                except Unsupported:
                    continue
                remainder = tuple(p - a.pixel(i) for a, p, i in zip(reference, xy, indexes))
                candidate = (sum(map(abs, remainder)), indexes, remainder)
                if candidate not in candidates:
                    candidates.append(candidate)
            if not candidates:
                raise Unsupported(f"{name!r} has no usable cell in the old or current work area.")
            candidates.sort()
            if (len(candidates) > 1 and candidates[0][0] == candidates[1][0]
                    and candidates[0][1] != candidates[1][1]):
                raise Unsupported(f"{name!r} has equally plausible cells in the old and current work areas.")
            _, cell, inset = candidates[0]
        if cell in occupied:
            raise Unsupported(f"{name!r} and {occupied[cell]!r} both occupy cell {cell}.")
        occupied[cell] = name
        icons[key] = xy, cell, inset, entry

    return current, offset, old_area, old_offset, icons


def checkpoint_positions(desktop, args, area, data):
    current, offset, old_area, old_offset, icons = collect_cells(desktop, args, area, data)
    # A pending resize is never checkpointed against its new geometry.
    if area != old_area or offset != old_offset:
        return
    snapshot = grid_record(area, current, offset)
    snapshot["observed_area"] = list(area)
    snapshot["cells"] = {
        key: {"xy": list(xy), "cell": list(cell), "inset": list(inset), "identity": entry["identity"]}
        for key, (xy, cell, inset, entry) in icons.items()
    }
    if desktop.area() == area and snapshot != read_json(desktop.checkpoint):
        write_json(desktop.checkpoint, snapshot)


def plan(desktop, args, area, data):
    current, offset, old_area, old_offset, icons = collect_cells(desktop, args, area, data)
    footprints = [[], []]
    for key, (_, cell, inset, _) in icons.items():
        for i, (before, after) in enumerate(desktop.label_footprint(key)):
            footprints[i].append((cell[i], 0, before, after))
    single_line_height = 48 + desktop.label_layout("Test").get_pixel_size()[1] + 2
    choices = best_layout(*area[1:], offset, single_line_height, args, current, footprints)
    axes = [choice.grid for choice in choices]
    selected = tuple(axis.adjust for axis in axes)
    old = grid_record(old_area, current, old_offset)
    new = grid_record(area, selected, offset)
    old["observed_area"] = new["observed_area"] = list(area)
    old["cells"] = {}
    new["cells"] = {}
    updates = {(GROUP, ADJUST): f"{selected[0]};{selected[1]};"}
    relocated, files = {}, []
    for key, (xy, cell, inset, entry) in icons.items():
        # Keep the logical slot while removing stale offsets from a prior grid.
        delta = (0, 0)
        target = tuple(slot_pixel(axis, index, n) for axis, index, n in zip(axes, cell, delta))
        before = {"xy": list(xy), "cell": list(cell), "inset": list(inset), "identity": entry["identity"]}
        old["cells"][key] = before
        new["cells"][key] = dict(before, xy=list(target), inset=list(delta))
        relocated[key] = xy, cell, target
        position = f"{target[0]},{target[1]}"
        kind, name = key.split(":", 1)
        if kind == "group":
            updates[name, POSITION] = position
        elif position != entry["position"]:
            files.append({"path": name, "identity": entry["identity"],
                          "old": entry["position"], "new": position})
    return old, new, axes, relocated, updates, files, choices


def icon_name(key):
    kind, name = key.split(":", 1)
    return Path(name).name if kind == "file" else name



def needs_recovery_write(change, commit):
    try:
        info = read_file_icon(Path(change["path"]))
    except FileNotFoundError:
        return False
    except GLib.Error as error:
        if error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_FOUND):
            return False
        raise
    return (info is not None and info["identity"] == change["identity"]
            and info["position"] == change["old" if commit else "new"])


def validate_recovery_files(desktop, pending):
    repair = pending.get("position_repair")
    if repair is not None:
        groups = repair.get("groups") if isinstance(repair, dict) else None
        if (not isinstance(groups, dict) or not isinstance(repair.get("committed"), bool)
                or not all(isinstance(pair, list) and len(pair) == 2
                           and all(isinstance(point, str) and re.fullmatch(r"\d+,\s*\d+", point)
                                   for point in pair) for pair in groups.values())):
            raise UnsafeRecovery("Invalid position-repair record. Keeping the journal.")
    changes = pending.get("files", [])
    if not isinstance(changes, list):
        raise UnsafeRecovery("Invalid GVfs recovery list. Keeping the journal.")
    if not changes:
        return
    root = desktop.desktop_directory()
    for change in changes:
        if (not isinstance(change, dict) or
                not all(key in change for key in ("path", "identity", "old", "new")) or
                not isinstance(change["path"], str) or Path(change["path"]).parent != root or
                not all(isinstance(change[key], str) and re.fullmatch(r"\d+,\s*\d+", change[key])
                        for key in ("old", "new"))):
            raise UnsafeRecovery("Recovery includes an invalid or out-of-desktop path. Keeping the journal.")


def recovery_side(pending, data, position_repair):
    try:
        current = adjustment(parse_metadata(data))
        if position_repair and current == tuple(pending["old"]["adjust"]):
            return "new" if position_repair["committed"] else "old"
        for side in ("new", "old"):
            if current == tuple(pending[side]["adjust"]):
                return side
    except (KeyError, TypeError, Unsupported, UnicodeError, configparser.Error) as error:
        raise UnsafeRecovery("Recovery information is inconsistent. Keeping the journal.") from error
    raise UnsafeRecovery("The grid was edited independently. Keeping the recovery journal.")


def recover_icon_positions(config, repair, side):
    updates = {}
    for name, (old, new) in repair["groups"].items():
        current = config.get(name, POSITION, fallback=None)
        target = new if side == "new" else old
        if current in (old, new) and current != target:
            updates[name, POSITION] = target
    return updates


def process_exited(pid):
    if not pid:
        return True
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rpartition(")")[2].split()
    except (FileNotFoundError, ProcessLookupError):
        return True
    return bool(fields and fields[0] == "Z")


def hold_visibility(desktop, pending):
    if desktop.ending or not desktop.settings.get_boolean(SETTING):
        raise Transient("The session is ending or desktop icons were turned off.")
    pending["visibility"] = "held"
    write_json(desktop.journal, pending)
    desktop.set_enabled(False)


def release_visibility(desktop, pending):
    if pending.get("visibility", "held") == "held":
        if not desktop.settings.get_boolean(SETTING):
            desktop.set_enabled(True)
        pending["visibility"] = "released"
        write_json(desktop.journal, pending)


def quiesce(desktop, pid, pending=None):
    hold_visibility(desktop, pending if pending is not None else read_json(desktop.journal))
    wait_until(lambda: not desktop.owner_pid() and not desktop.client_pid()
               and process_exited(pid), "Nemo Desktop to exit")


def await_desktop(desktop, description, owner):
    try:
        return wait_until(desktop.mapped_pid, description, timeout=1.5)
    except Transient:
        desktop.require_compositor(owner)
        if not desktop.settings.get_boolean(SETTING):
            raise
        if not (desktop.owner_pid() or desktop.client_pid()):
            desktop.check_session()
            log("Cinnamon did not re-launch Nemo Desktop. Retrying the autostart condition once.")
            pending = read_json(desktop.journal)
            try:
                hold_visibility(desktop, pending)
                time.sleep(0.25)
            finally:
                release_visibility(desktop, pending)
        return wait_until(desktop.mapped_pid, description)


def file_inventory_matches(desktop, planned):
    current = desktop.file_icons()
    expected = {key: entry for key, entry in planned.items() if key.startswith("file:")}
    if current.keys() != expected.keys():
        return False
    for key, entry in current.items():
        point = re.fullmatch(r"(\d+),\s*(\d+)", entry["position"] or "")
        if (entry["identity"] != expected[key]["identity"] or not point
                or list(map(int, point.groups())) != expected[key]["xy"]):
            return False
    return True


def apply(desktop, args, expected_area=None):
    pump()
    if not desktop.settings.get_boolean(SETTING):
        log("Desktop icons are disabled. Skipping.")
        return
    area = desktop.area()
    if expected_area and area != expected_area:
        raise Unsupported("The work area changed during the attempt.")
    desktop.verify_randr()
    desktop.check_icons()
    if not args.watch and desktop.settings.get_boolean("volumes-visible"):
        # GVfs can publish its first mount snapshot just after GDK startup.
        desktop.mount_groups()
        time.sleep(0.12)
        pump()
    data, _ = desktop.read()
    old, new, axes, icons, updates, files, choices = plan(desktop, args, area, data)
    log(f"{area[0]} work area {area[1]}x{area[2]}: {old['adjust']} -> {new['adjust']} percent; "
        f"icon origin {axes[0].origin},{axes[1].origin}; pitch {axes[0].pitch}x{axes[1].pitch}")
    log(f"  Nominal margin mismatch {abs(axes[0].origin-axes[1].origin)} px; "
        f"estimated bounds clearance L/T/R/B {choices[0].leading}/{choices[1].leading}/"
        f"{choices[0].trailing}/{choices[1].trailing} px.")
    font_line = desktop.label_layout("Test").get_pixel_size()[1]
    log(f"  Two-line label reserve: {two_line_row_pitch(48 + font_line + 2)} px per row.")
    for label, choice in zip(("horizontal", "vertical"), choices):
        if choice.margin_shortfall or choice.pitch_shortfall:
            log(f"  {label.capitalize()} fallback: margin shortfall {choice.margin_shortfall} px, "
                f"pitch shortfall {choice.pitch_shortfall} px.")
    if args.dry_run or args.verbose:
        for name, (before, cell, after) in icons.items():
            log(f"  {icon_name(name)!r}: {before} -> {after}, column {cell[0]}, row {cell[1]}")
    same_spacing = old["adjust"] == new["adjust"]
    misaligned = any(before != after for before, _, after in icons.values())
    if same_spacing and not misaligned:
        log("Existing spacing and icon positions are already selected. No restart.")
        if not args.dry_run:
            write_json(desktop.checkpoint, old)
        return
    if same_spacing:
        log("Existing spacing is already selected. Realigning saved icon positions.")
    if args.dry_run:
        return

    desktop.check_session()
    if desktop.pointer_dragging():
        raise Transient("Waiting for the primary mouse button to be released.")
    owner = desktop.require_compositor()
    pid = wait_until(desktop.mapped_pid, "the Cinnamon-managed desktop window")
    pump()
    desktop.require_compositor(owner)
    if desktop.pointer_dragging():
        raise Transient("Waiting for the primary mouse button to be released.")
    if desktop.ending or not desktop.settings.get_boolean(SETTING):
        log("The session is ending or desktop icons are disabled. Skipping.")
        return
    transaction = {"old": old, "new": new, "files": files, "visibility": "prepared"}
    initial_mounts = desktop.mount_groups()
    if same_spacing:
        repair_groups = {}
        for key, (before, _, after) in icons.items():
            kind, name = key.split(":", 1)
            if kind == "group" and before != after:
                repair_groups[name] = [f"{before[0]},{before[1]}", updates[name, POSITION]]
        transaction["position_repair"] = {"groups": repair_groups, "committed": False}
    write_json(desktop.journal, transaction)
    start = time.monotonic()
    writing = False
    try:
        quiesce(desktop, pid, transaction)
        desktop.require_compositor(owner)
        stopped = time.monotonic()
        if desktop.area() != area:
            raise Unsupported("The work area changed after the desktop stopped.")
        desktop.verify_randr()
        desktop.check_icons()
        latest, mode = desktop.read()
        observed = plan(desktop, args, area, latest)
        if observed != (old, new, axes, icons, updates, files, choices):
            raise Unsupported("The grid changed during shutdown. Skipping the write.")
        pump()
        if (desktop.ending or desktop.area() != area or desktop.owner_pid()
                or desktop.settings.get_boolean(SETTING)):
            raise Unsupported("The work area or desktop lifecycle changed before writing.")

        writing = True
        try:
            for change in files:
                file_update(change, commit=True)
            pump()
            desktop.require_compositor(owner)
            if (desktop.ending or desktop.area() != area or desktop.owner_pid()
                    or desktop.settings.get_boolean(SETTING) or desktop.read()[0] != latest
                    or desktop.mount_groups() != initial_mounts
                    or not file_inventory_matches(desktop, new["cells"])):
                raise Unsupported("Nemo metadata or the session changed before commit.")
            atomic_write(METADATA, patch_metadata(latest, updates), mode)
            if same_spacing:
                transaction["position_repair"]["committed"] = True
                write_json(desktop.journal, transaction)
        except BaseException:
            if desktop.owner_pid() or desktop.client_pid():
                raise
            if same_spacing:
                pending = read_json(desktop.journal)["position_repair"]
                if not pending["committed"]:
                    current_data, current_mode = desktop.read()
                    repairs = recover_icon_positions(parse_metadata(current_data), pending, "old")
                    if repairs:
                        atomic_write(METADATA, patch_metadata(current_data, repairs), current_mode)
                    for change in files:
                        file_update(change, commit=False, recover=True)
                    writing = False
            # For spacing changes, desktop-metadata remains the commit record.
            elif adjustment(parse_metadata(desktop.read()[0])) == tuple(old["adjust"]):
                for change in files:
                    file_update(change, commit=False, recover=True)
                writing = False
            raise
    finally:
        release_visibility(desktop, transaction)
        if not writing:
            forget_journal(desktop)

    if desktop.ending:
        return
    if not desktop.settings.get_boolean(SETTING):
        write_json(desktop.checkpoint, new)
        forget_journal(desktop)
        return
    new_pid = await_desktop(desktop, "the replacement desktop window", owner)
    desktop.require_compositor(owner)
    if new_pid == pid:
        raise RuntimeError("The expected replacement Nemo Desktop process did not appear.")
    verify_layout(desktop, new)
    write_json(desktop.checkpoint, new)
    forget_journal(desktop)
    log(f"Nemo Desktop {pid} -> {new_pid}; stop {(stopped-start)*1000:.0f} ms, "
        f"edit and remap {(time.monotonic()-stopped)*1000:.0f} ms.")


def validate_layout_record(record):
    try:
        model, width, height = record["area"]
        if (not isinstance(model, str) or not all(type(n) is int and n > 0 for n in (width, height))
                or type(record["offset"]) is not int or not isinstance(record["cells"], dict)):
            raise ValueError()
        for key, entry in record["cells"].items():
            if (not key.startswith(("file:", "group:")) or "identity" not in entry
                    or len(entry["cell"]) != 2 or not all(type(n) is int and n >= 0 for n in entry["cell"])):
                raise ValueError()
    except (KeyError, TypeError, ValueError) as error:
        raise UnsafeRecovery("Invalid saved layout in the recovery journal. Keeping the journal.") from error


def verify_layout(desktop, record):
    """Check the committed grid and surviving logical cells before accepting a checkpoint."""
    validate_layout_record(record)
    try:
        actual = parse_metadata(desktop.read()[0])
        current = adjustment(actual)
    except (Unsupported, UnicodeError, configparser.Error) as error:
        raise UnsafeRecovery("Could not verify the committed grid. Keeping the journal.") from error
    if current != tuple(record["adjust"]):
        raise UnsafeRecovery("Nemo did not retain the selected grid spacing. Keeping the journal.")
    area = desktop.area()
    if area[0] != record["area"][0]:
        raise UnsafeRecovery("The saved grid belongs to a different monitor. Keeping the journal.")
    offset = desktop.vertical_offset()
    axes = [Axis.for_area(length, adjust, index, offset)
            for index, (length, adjust) in enumerate(zip(area[1:], current))]
    files = desktop.file_icons()
    mounts = desktop.mount_groups()
    verified = {}
    for key, saved in record["cells"].items():
        kind, name = key.split(":", 1)
        if kind == "file":
            entry = files.get(key)
            if entry is None or entry["identity"] != saved["identity"]:
                continue
            raw = entry["position"]
        else:
            if name.endswith(".volume"):
                if name not in mounts or mounts[name] != saved["identity"]:
                    continue
            elif name in ICONS and not desktop.settings.get_boolean(f"{name}-icon-visible"):
                continue
            raw = actual.get(name, POSITION, fallback=None)
        point = re.fullmatch(r"(\d+),\s*(\d+)", raw or "")
        if not point:
            raise UnsafeRecovery(f"Nemo lost the position of {icon_name(key)!r}. Keeping the journal.")
        xy = list(map(int, point.groups()))
        try:
            cell = [axis.cell(pixel) for axis, pixel in zip(axes, xy)]
        except Unsupported:
            cell = None
        if cell != saved["cell"]:
            raise UnsafeRecovery(f"Nemo moved {icon_name(key)!r} to a different grid cell. Keeping the journal.")
        verified[key] = dict(saved, xy=xy, inset=[pixel - axis.pixel(index)
                                                  for axis, index, pixel in zip(axes, cell, xy)])
    if desktop.area() != area:
        raise Transient("The work area changed during verification. The journal is still available.")
    record.update(area=list(area), observed_area=list(area), offset=offset, cells=verified)


DBUS = "org.freedesktop.DBus"
PROPERTIES = DBUS + ".Properties"
GVFS = "org.gtk.vfs.Metadata"
GVFS_PATH = "/org/gtk/vfs/metadata"
LOGIND = "org.freedesktop.login1"
LOGIND_PATH = "/org/freedesktop/login1"
WATCH_KEYS = {SETTING, "desktop-layout", "use-desktop-grid", "font", "text-ellipsis-limit",
              "volumes-visible", *(f"{icon}-icon-visible" for icon in ICONS)}


def retryable(error):
    if isinstance(error, (Transient, FileNotFoundError, subprocess.TimeoutExpired)):
        return True
    if isinstance(error, OSError):
        return error.errno in (errno.EAGAIN, errno.EBUSY, errno.EINTR, errno.ESTALE)
    if isinstance(error, GLib.Error):
        return any(error.matches(quark, code) for quark, codes in (
            (Gio.io_error_quark(), (Gio.IOErrorEnum.NOT_FOUND, Gio.IOErrorEnum.BUSY,
                                   Gio.IOErrorEnum.TIMED_OUT, Gio.IOErrorEnum.WOULD_BLOCK)),
            (Gio.dbus_error_quark(), (Gio.DBusError.NO_REPLY, Gio.DBusError.TIMEOUT,
                                     Gio.DBusError.NAME_HAS_NO_OWNER, Gio.DBusError.SERVICE_UNKNOWN)),
        ) for code in codes)
    return False


def metadata_geometry(data):
    config = parse_metadata(data)
    return tuple((name, tuple(sorted(config.items(name)))) for name in config.sections()
                 if name.startswith("desktop-monitor-"))


def validate_logind(desktop, ident):
    system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def call(path, interface, name, signature, *values):
        return system_bus.call_sync(LOGIND, path, interface, name,
                                         GLib.Variant(signature, values), None,
                                         Gio.DBusCallFlags.NONE, 1200, None).unpack()[0]

    manager_pid = desktop.call(DBUS, "/org/freedesktop/DBus", DBUS,
                                    "GetConnectionUnixProcessID",
                                    GLib.Variant("(s)", (SESSION,)))[0]
    session = call(LOGIND_PATH, LOGIND + ".Manager", "GetSessionByPID", "(u)", manager_pid)
    props = call(session, PROPERTIES, "GetAll", "(s)", LOGIND + ".Session")
    display = desktop.display.get_name().removesuffix(".0")
    session_display = props["Display"]
    if not session_display:
        # logind omits Display for some seatless X11 logins.
        environment = Path(f"/proc/{manager_pid}/environ").read_bytes().split(b"\0")
        session_display = next((os.fsdecode(item[8:]) for item in environment
                                if item.startswith(b"DISPLAY=")), "")
    if (props["Id"] != ident or props["Type"] != "x11" or props["User"][0] != os.geteuid()
            or session_display.removesuffix(".0") != display or props["State"] == "closing"):
        raise Unsupported("The requested logind session does not own this Cinnamon X11 desktop.")
    return system_bus, session


class CrashGuard:
    """Pause compensation after three compositor losses in one minute."""
    def __init__(self, path):
        self.path = path
        self.boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        try:
            record = read_json(path) if path else None
            if record and record["boot"] == self.boot:
                self.losses = [float(value) for value in record["losses"]]
                self.resume_at = float(record["resume_at"])
                return
        except (OSError, ValueError, TypeError, KeyError, UnsafeRecovery) as error:
            log(f"Could not read compositor history: {error}")
        self.losses, self.resume_at = [], 0.0

    def note_loss(self, now):
        self.losses = [loss for loss in self.losses if 0 <= now - loss <= 60]
        self.losses.append(now)
        if len(self.losses) >= 3:
            self.resume_at = now + 90
            log("Repeated Cinnamon crashes. Pausing compensation for 90 seconds.")
        if self.path:
            try:
                write_json(self.path, {"boot": self.boot, "losses": self.losses,
                                       "resume_at": self.resume_at})
            except OSError as error:
                log(f"Could not save compositor history: {error}")


class Watcher:
    def __init__(self, desktop, args):
        self.desktop, self.args = desktop, args
        self.loop = GLib.MainLoop()
        self.full = self.snapshot = self.fallback = 0
        self.busy = self.reschedule = False
        self.retries = 0
        self.last_area = self.geometry()
        self.metadata = None
        self.nemo_owner = None
        self.compositor = desktop.compositor_owner()
        self.settle_until = 0.0
        self.crash_guard = CrashGuard(None if args.dry_run else STATE / "compositor.json")
        self.directory = None
        self.folder_monitor = None
        self.failure = None
        display = desktop.display
        screen = display.get_default_screen()
        screen.connect("monitors-changed", self.geometry_changed)
        screen.connect("size-changed", self.geometry_changed)
        display.connect("closed", self.stop)
        self.root_watcher = Gio.Subprocess.new(
            ["stdbuf", "-oL", "xprop", "-root", "-spy", "_NET_WORKAREA", "_NET_CURRENT_DESKTOP",
             *(f"_GTK_WORKAREAS_D{index}" for index in range(32))],
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        self.root_stream = Gio.DataInputStream.new(self.root_watcher.get_stdout_pipe())
        self.root_stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.root_event)
        self.meta_monitor = Gio.File.new_for_path(str(METADATA.parent)).monitor_directory(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.meta_monitor.connect("changed", self.metadata_changed)
        self.prefs = Gio.Settings.new("org.nemo.preferences")
        self.prefs.connect("changed::desktop-is-home-dir", self.folder_changed)
        self.refresh_folder()
        desktop.settings.connect("changed", self.settings_changed)
        for signal_name in ("mount-added", "mount-removed", "mount-changed"):
            desktop.volume_monitor.connect(signal_name, self.inventory_changed)
        bus = desktop.bus
        bus.set_exit_on_close(False)
        bus.connect("closed", self.stop)
        for name in (DESKTOP, SESSION, GVFS, COMPOSITOR):
            bus.signal_subscribe(DBUS, DBUS, "NameOwnerChanged", "/org/freedesktop/DBus",
                                 name, Gio.DBusSignalFlags.NONE, self.owner_changed)
        bus.signal_subscribe(SESSION, SESSION, "SessionOver", SESSION_PATH, None,
                             Gio.DBusSignalFlags.NONE, self.stop)
        bus.signal_subscribe(GVFS, GVFS, "AttributeChanged", GVFS_PATH, None,
                             Gio.DBusSignalFlags.NONE, self.attribute_changed)
        self.watch_logind()
        self.check_gvfs()
        self.signals = [GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self.stop)
                        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)]

    def watch_logind(self):
        if not self.args.logind:
            return
        self.system_bus, session = self.args.logind
        ident = self.args.session_id
        self.system_bus.signal_subscribe(LOGIND, LOGIND + ".Manager", "SessionRemoved",
                                         LOGIND_PATH, ident, Gio.DBusSignalFlags.NONE, self.stop)
        self.system_bus.signal_subscribe(LOGIND, PROPERTIES, "PropertiesChanged", session,
                                         LOGIND + ".Session", Gio.DBusSignalFlags.NONE,
                                         self.session_properties)

    def session_properties(self, _connection, _sender, _path, _interface, _signal, parameters):
        if parameters.unpack()[1].get("State") == "closing":
            self.stop()

    def stop(self, *_event):
        self.desktop.ending = True
        self.loop.quit()
        return GLib.SOURCE_CONTINUE

    def root_event(self, stream, result):
        try:
            line, _ = stream.read_line_finish(result)
            if line is None:
                if not self.desktop.ending:
                    self.failure = Transient("The X11 work-area event stream closed.")
                    self.stop()
                return
            self.geometry_changed()
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.root_event)
        except GLib.Error as error:
            if not self.desktop.ending:
                self.failure = error
                self.stop()

    def geometry(self):
        try:
            return self.desktop.area()
        except Unsupported:
            return None

    def geometry_changed(self, *_event):
        area = self.geometry()
        if area != self.last_area:
            self.last_area = area
            self.queue_full()

    def check_gvfs(self):
        try:
            (xml,) = self.desktop.call(GVFS, GVFS_PATH, DBUS + ".Introspectable", "Introspect")
            interface = Gio.DBusNodeInfo.new_for_xml(xml).lookup_interface(GVFS)
            native = interface and interface.lookup_signal("AttributeChanged")
        except GLib.Error:
            native = False
        if native and self.fallback:
            GLib.source_remove(self.fallback)
            self.fallback = 0
        elif not native and not self.fallback and self.directory and not self.args.dry_run:
            log("GVfs has no metadata signal. Sampling desktop icon positions every five seconds.")
            self.fallback = GLib.timeout_add_seconds(5, self.poll_positions)

    def poll_positions(self):
        if not self.busy and not self.full and not self.desktop.ending:
            self.queue_snapshot()
        return GLib.SOURCE_CONTINUE

    def owner_changed(self, _connection, _sender, _path, _interface, _signal, parameters):
        name, old, new = parameters.unpack()
        if name == SESSION and old and old != new:
            self.stop()
        elif name == COMPOSITOR:
            if old and new != old:
                self.crash_guard.note_loss(time.monotonic())
            self.compositor = new or None
            if new:
                self.settle_until = time.monotonic() + max(2.0, self.args.debounce)
                log("Cinnamon returned. Waiting for the desktop to settle.")
                self.queue_full()
            else:
                log("Cinnamon disappeared. Pausing desktop adjustments.")
        elif name == GVFS and not self.desktop.ending:
            if new:
                self.check_gvfs()
            self.queue_snapshot()
        elif name == DESKTOP and new and not self.busy and new != self.nemo_owner:
            self.queue_full()

    def refresh_folder(self):
        if self.folder_monitor:
            self.folder_monitor.cancel()
            self.folder_monitor = None
        try:
            self.directory = self.desktop.desktop_directory()
        except Unsupported:
            self.directory = None
            return
        self.folder_monitor = Gio.File.new_for_path(str(self.directory)).monitor_directory(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.folder_monitor.connect("changed", self.folder_event)

    def folder_changed(self, *_event):
        self.refresh_folder()
        self.queue_full()

    def folder_event(self, _monitor, file, other, event):
        if event in (Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.DELETED,
                     Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED,
                     Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.MOVED_OUT):
            self.queue_full()
        elif event == Gio.FileMonitorEvent.CHANGES_DONE_HINT:
            name = file.get_basename()
            if name.endswith(".desktop") or name == ".hidden":
                self.queue_full()

    def inventory_changed(self, *_event):
        if self.desktop.settings.get_boolean("volumes-visible"):
            self.queue_full()

    def attribute_changed(self, _connection, _sender, _path, _interface, _signal, parameters):
        if self.directory is None:
            return
        tree, name = parameters.unpack()
        namespace = Path(tree).name
        if namespace == "root":
            belongs = Path(name).parent == self.directory
        elif namespace == "home":
            belongs = (Path.home() / name.lstrip("/")).parent == self.directory
        else:
            # Device-backed trees use mount-relative paths. Re-read only this desktop.
            belongs = True
        if belongs and not self.busy:
            self.queue_snapshot()

    def metadata_changed(self, _monitor, file, other, _event):
        if self.busy or all(f is None or f.get_path() != str(METADATA) for f in (file, other)):
            return
        self.queue_snapshot()

    def settings_changed(self, _settings, key):
        if key in WATCH_KEYS and not (self.busy and key == SETTING):
            self.queue_full()

    def queue_full(self, delay=None):
        if self.desktop.ending:
            return
        if self.busy:
            self.reschedule = True
            return
        if delay is None:
            self.retries = 0
            delay = self.args.debounce
        if self.full:
            GLib.source_remove(self.full)
        self.full = GLib.timeout_add(max(1, round(delay * 1000)), self.optimize)

    def queue_snapshot(self):
        if not (self.desktop.ending or self.snapshot or self.full):
            self.snapshot = GLib.idle_add(self.checkpoint, priority=GLib.PRIORITY_DEFAULT_IDLE)

    def checkpoint(self):
        self.snapshot = 0
        if (self.full or self.busy or self.desktop.ending or not self.compositor
                or time.monotonic() < self.settle_until):
            return GLib.SOURCE_REMOVE
        if not self.desktop.settings.get_boolean(SETTING):
            return GLib.SOURCE_REMOVE
        try:
            area = self.desktop.area()
            if area != self.last_area:
                self.geometry_changed()
                return GLib.SOURCE_REMOVE
            data, _ = self.desktop.read()
            if metadata_geometry(data) != self.metadata:
                self.queue_full()
            elif not self.args.dry_run:
                checkpoint_positions(self.desktop, self.args, area, data)
        except (Unsupported, Transient, FileNotFoundError):
            pass
        except (OSError, GLib.Error, ValueError, configparser.Error) as error:
            if not retryable(error):
                self.failure = error
                self.stop()
        return GLib.SOURCE_REMOVE

    def optimize(self):
        self.full = 0
        if self.desktop.ending or not self.compositor:
            return GLib.SOURCE_REMOVE
        remaining = max(self.settle_until, self.crash_guard.resume_at) - time.monotonic()
        if remaining > 0:
            self.queue_full(remaining)
            return GLib.SOURCE_REMOVE
        self.busy = True
        delay = None
        try:
            self.desktop.check_session()
            if self.desktop.settings.get_boolean(SETTING):
                if not self.desktop.mapped_pid():
                    raise Transient("Waiting for Cinnamon-managed Nemo Desktop to map.")
                apply(self.desktop, self.args, self.desktop.area())
                self.metadata = metadata_geometry(self.desktop.read()[0])
                try:
                    (self.nemo_owner,) = self.desktop.call(DBUS, "/org/freedesktop/DBus", DBUS,
                                                           "GetNameOwner", GLib.Variant("(s)", (DESKTOP,)))
                except GLib.Error as error:
                    if not retryable(error):
                        raise
            else:
                log("Desktop icons are disabled. Waiting for a change.")
            self.retries = 0
        except (RuntimeError, OSError, GLib.Error, ValueError, configparser.Error,
                subprocess.SubprocessError) as error:
            if self.desktop.ending:
                return GLib.SOURCE_REMOVE
            if self.desktop.journal.exists() and not self.args.dry_run:
                # Exit through the normal recovery path before accepting further events.
                self.failure = error
                self.stop()
            elif retryable(error) and self.retries < 3:
                self.retries += 1
                delay = max(self.args.debounce, 0.3) * 2 ** (self.retries - 1)
                log(f"Waiting for the desktop to settle ({self.retries}/3): {error}")
            elif isinstance(error, Unsupported) or retryable(error):
                log(f"Skipping until another desktop event: {error}")
            else:
                self.failure = error
                self.stop()
        finally:
            self.busy = False
            if self.reschedule or delay is not None:
                self.reschedule = False
                self.queue_full(delay)
        return GLib.SOURCE_REMOVE

    def run(self):
        log(f"Watching Cinnamon X11 events with a {self.args.debounce:.2f} s debounce.")
        self.queue_full()
        try:
            self.loop.run()
        finally:
            for source in (self.full, self.snapshot, self.fallback, *self.signals):
                if source:
                    GLib.source_remove(source)
            self.root_watcher.force_exit()
            self.root_watcher.wait(None)
        if self.failure:
            # Event stream failures should use ordinary transaction recovery.
            self.desktop.ending = False
            raise self.failure


def wait_for_cinnamon(desktop):
    # Cinnamon may start XDG applications before entering its running phase.
    ready = GLib.MainLoop()
    subscription = desktop.bus.signal_subscribe(
        SESSION, SESSION, "SessionRunning", SESSION_PATH, None,
        Gio.DBusSignalFlags.NONE, lambda *_: ready.quit())
    def end_startup_wait():
        ready.quit()
        return GLib.SOURCE_CONTINUE
    timeout = GLib.timeout_add_seconds(20, end_startup_wait)
    try:
        if not desktop.session("IsSessionRunning")[0]:
            ready.run()
    finally:
        desktop.bus.signal_unsubscribe(subscription)
        GLib.source_remove(timeout)
    desktop.check_session()


def wait_for_compositor(desktop):
    previous, since = None, 0.0

    def settled():
        nonlocal previous, since
        owner = desktop.compositor_owner()
        if not owner:
            previous = None
            return False
        try:
            current = owner, desktop.area()
        except Unsupported:
            current = owner, None
        if current != previous:
            previous, since = current, time.monotonic()
        return time.monotonic() - since >= 2.0

    wait_until(settled, "a stable Cinnamon compositor", timeout=20)


def watch(desktop, args):
    Watcher(desktop, args).run()


GRID_MODE = "use-desktop-grid"
INITIAL_KEYS = {"nemo-icon-view-auto-layout": "false",
                "nemo-icon-view-keep-aligned": "true", "nemo-icon-view-zoom-level": "3"}


def read_optional_metadata(desktop):
    try:
        return desktop.read()
    except FileNotFoundError:
        return b"", 0o600


def initial_metadata(data, settings):
    config = parse_metadata(data)
    if any(group.startswith("desktop-monitor-") and group != GROUP for group in config.sections()):
        raise Unsupported("Initialization requires a single-monitor Nemo configuration.")
    if config.getint(GROUP, "nemo-icon-view-zoom-level", fallback=3) != 3:
        raise Unsupported("Choose Normal icon size before initializing an existing non-Normal layout.")
    updates = {key: value for key, value in INITIAL_KEYS.items()
               if config.get(GROUP, key, fallback=None) != value}
    if config.has_option(GROUP, ADJUST):
        adjustment(config)
    else:
        h = round(settings.get_double("horizontal-grid-adjust") * 100)
        v = round(settings.get_double("vertical-grid-adjust") * 100)
        updates[ADJUST] = f"{h if 50 <= h <= 200 else 100};{v if 75 <= v <= 200 else 100};"
    existing = {(GROUP, key): value for key, value in updates.items() if config.has_option(GROUP, key)}
    data = patch_metadata(data, existing)
    missing = {key: value for key, value in updates.items() if (GROUP, key) not in existing}
    if missing:
        text = data.decode("utf-8")
        insert = "".join(f"{key}={value}\n" for key, value in missing.items())
        if config.has_section(GROUP):
            header = re.search(r"^\[" + re.escape(GROUP) + r"\][ \t]*(?:\r?\n|$)", text, re.M)
            if not header:
                raise Unsupported("Cannot find the exact monitor section header.")
            sep = "" if header.group().endswith("\n") else "\n"
            text = text[:header.end()] + sep + insert + text[header.end():]
        else:
            text += f"{'\n' if text else ''}[{GROUP}]\n{insert}"
        data = text.encode("utf-8")
    adjustment(parse_metadata(data))
    return data


def settings_grid_mode(desktop, enabled):
    if desktop.settings.get_boolean(GRID_MODE) != enabled:
        if not desktop.settings.set_boolean(GRID_MODE, enabled):
            raise RuntimeError("Nemo's modern grid setting could not be updated.")
        Gio.Settings.sync()


def forget_journal(desktop):
    desktop.journal.unlink()
    sync_directory(STATE)


def initial_fingerprint(data):
    config = parse_metadata(data)
    return [config.get(GROUP, key, fallback=None) for key in (*INITIAL_KEYS, ADJUST)]


def recover_initialization(desktop, pending, phase):
    try:
        current, _ = read_optional_metadata(desktop)
        digest = initial_fingerprint(current)
        old, new, writing = pending["old"], pending["new"], pending["writing"]
        if not isinstance(writing, bool) or not all(isinstance(value, list) for value in (old, new)):
            raise ValueError()
    except (KeyError, TypeError, ValueError, UnicodeError, configparser.Error) as error:
        raise UnsafeRecovery("Invalid initialization recovery data. Keeping the journal.") from error
    if phase == "prepared" or not writing:
        if phase == "prepared" and (writing or digest != old):
            raise UnsafeRecovery("Nemo changed before initialization began. Keeping the journal.")
        return
    if digest == new:
        settings_grid_mode(desktop, True)
        if not desktop.settings.get_boolean(GRID_MODE):
            raise UnsafeRecovery("Nemo did not retain the initialized grid mode. Keeping the journal.")
    elif digest != old:
        raise UnsafeRecovery("Nemo changed the initialization metadata independently. Keeping the journal.")


def verify_initial_layout(desktop, args):
    for attempt in range(4):
        try:
            apply(desktop, args)
            return
        except AwaitingPlacement:
            if attempt == 3:
                raise
            time.sleep(0.2)
            pump()


def initialize(desktop, args):
    desktop.check_session()
    area = desktop.area()
    desktop.verify_randr()
    if desktop.settings.get_string("desktop-layout").split("::")[0] != "true":
        raise Unsupported("Nemo is not configured to draw icons on the primary monitor.")
    current, _ = read_optional_metadata(desktop)
    desired = initial_metadata(current, desktop.settings)
    modern = desktop.settings.get_boolean(GRID_MODE)
    enabled = desktop.settings.get_boolean(SETTING)
    if not modern:
        if not desktop.settings.is_writable(GRID_MODE):
            raise Unsupported("Nemo's modern grid setting is locked.")
        entries = desktop.file_icons()
        if (any(entry["position"] for entry in entries.values()) or
                any(parse_metadata(current).has_option(group, POSITION)
                    for group in parse_metadata(current).sections())):
            raise Unsupported("Switching this populated legacy desktop would risk moving icons.")
    if current == desired and modern:
        log("Nemo already has the required desktop configuration.")
        if enabled:
            verify_initial_layout(desktop, args)
        else:
            log("Desktop icons are disabled. The initial optimization is deferred.")
        return
    h, v = adjustment(parse_metadata(desired))
    log(f"{'Would initialize' if args.dry_run else 'Initializing'} the modern grid, "
        f"Auto-arrange off, Align to grid on, Normal icons and spacing {h};{v}.")
    if not enabled:
        log("Desktop icons are disabled. The initial optimization is deferred.")
    if args.dry_run:
        return
    owner = desktop.require_compositor()
    pid = wait_until(desktop.mapped_pid, "the Cinnamon-managed desktop window") if enabled else None
    if desktop.settings.get_boolean(SETTING) != enabled:
        raise Unsupported("Desktop icon visibility changed before initialization.")
    pending = {"initialization": True, "restore_icons": enabled, "writing": False,
               "visibility": "prepared" if enabled else "released",
               "old": initial_fingerprint(current), "new": initial_fingerprint(desired)}
    write_json(desktop.journal, pending)
    try:
        if enabled:
            quiesce(desktop, pid, pending)
        desktop.require_compositor(owner)
        if desktop.area() != area or desktop.owner_pid() or desktop.settings.get_boolean(SETTING):
            raise Unsupported("The work area or desktop lifecycle changed before initialization.")
        latest, mode = read_optional_metadata(desktop)
        if metadata_geometry(current) and metadata_geometry(latest) != metadata_geometry(current):
            raise Unsupported("Nemo changed the grid configuration during shutdown. Retry initialization.")
        desired = initial_metadata(latest, desktop.settings)
        pending.update(writing=True, old=initial_fingerprint(latest),
                       new=initial_fingerprint(desired))
        write_json(desktop.journal, pending)
        METADATA.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if latest != desired:
            atomic_write(METADATA, desired, mode)
        settings_grid_mode(desktop, True)
    finally:
        if enabled:
            release_visibility(desktop, pending)
        if not pending["writing"]:
            forget_journal(desktop)
    if enabled and desktop.settings.get_boolean(SETTING):
        await_desktop(desktop, "the initialized Nemo desktop", owner)
    forget_journal(desktop)
    if enabled and desktop.settings.get_boolean(SETTING):
        verify_initial_layout(desktop, args)


def bootstrap_initialization(desktop, args):
    raw, _ = read_optional_metadata(desktop)
    config = parse_metadata(raw)
    missing = [key for key in (*INITIAL_KEYS, ADJUST) if not config.has_option(GROUP, key)]
    if not missing:
        return
    # Nemo may write the stock alignment and auto-arrange defaults before XDG starts us.
    stock = {"nemo-icon-view-auto-layout": "true", "nemo-icon-view-keep-aligned": "true"}
    established = (desktop.checkpoint.exists() or not desktop.settings.get_boolean(GRID_MODE)
                   or any(group.startswith("desktop-monitor-") and group != GROUP
                          for group in config.sections())
                   or any(config.get(GROUP, key, fallback=value) != value
                          for key, value in stock.items())
                   or config.has_option(GROUP, "nemo-icon-view-zoom-level")
                   or config.has_option(GROUP, ADJUST))
    if established:
        log(f"Partial Nemo grid configuration (missing {', '.join(missing)}). "
            "Stop the watcher, then preview with nemo-grid-compensator --init --dry-run "
            "and apply explicitly with --init.")
        return
    initialize(desktop, args)


def dimensions(value):
    if match := re.fullmatch(r"(\d+)[x,](\d+)", value):
        return tuple(map(int, match.groups()))
    raise argparse.ArgumentTypeError("Expected two integers separated by x or a comma.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--once", action="store_true", help="Apply once (default)")
    modes.add_argument("--watch", action="store_true", help="Monitor resolution changes in the foreground")
    modes.add_argument("--init", action="store_true", help="Initialize an unconfigured Nemo desktop")
    parser.add_argument("--initialize", action="store_true", help="Bootstrap a fresh profile before watching")
    parser.add_argument("--session-id", help="Require this X11 logind session (for service launchers)")
    modes.add_argument("--recover", action="store_true", help="Restore desktop icons after an interrupted transaction")
    parser.add_argument("--dry-run", action="store_true", help="Calculate positions without writing settings or files")
    parser.add_argument("--verbose", action="store_true", help="Print the logical cell of each icon")
    parser.add_argument("--margin", type=dimensions, default=(25, 25), metavar="LEFT,TOP",
                        help="Target nominal image margins (default: 25,25)")
    parser.add_argument("--min-margin", type=dimensions, default=(15, 15), metavar="X,Y",
                        help="Minimum nominal image margins (default: 15,15)")
    parser.add_argument("--min-label-clearance", type=int, default=10, metavar="PIXELS",
                        help="Minimum estimated icon and label clearance (default: 10)")
    parser.add_argument("--pitch", type=dimensions, default=(80, 85), metavar="X,Y",
                        help="Target cell pitch in pixels (default: 80x85)")
    parser.add_argument("--min-pitch", type=dimensions, default=(70, 75), metavar="X,Y",
                        help="Minimum cell pitch in pixels (default: 70x75)")
    parser.add_argument("--preferred-max-pitch", type=dimensions, default=(100, 110), metavar="X,Y",
                        help="Soft pitch ceilings in pixels (default: 100x110)")
    parser.add_argument("--debounce", type=float, default=0.65, metavar="SECONDS")
    parser.add_argument("--hysteresis", type=int, default=2, metavar="PIXELS")
    parser.add_argument("--old-area", type=dimensions, metavar="WIDTHxHEIGHT",
                        help="Known work area of existing positions, for a one-shot run")
    args = parser.parse_args()
    if (not all(1 <= n <= 8192 for n in (*args.pitch, *args.min_pitch, *args.preferred_max_pitch))
            or not all(0 <= n <= 8192 for n in (*args.margin, *args.min_margin, args.min_label_clearance))
            or not 0.10 <= args.debounce <= 30 or not 0 <= args.hysteresis <= 8192):
        parser.error("Invalid pitch, margin, debounce, or hysteresis.")
    if args.old_area and (args.watch or args.recover or args.init or min(args.old_area) < 1):
        parser.error("--old-area requires a positive width and height and is for one-shot use.")
    if args.recover and args.dry_run:
        parser.error("--recover cannot be combined with --dry-run.")

    def interrupt(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGHUP, interrupt)
    desktop = Desktop()
    if (args.session_id or args.initialize) and not args.watch:
        parser.error("--session-id and --initialize apply to --watch only.")
    if args.initialize and args.dry_run:
        parser.error("--initialize requires an active watcher. Use --init --dry-run to preview it.")
    if args.watch:
        wait_for_cinnamon(desktop)
        args.logind = validate_logind(desktop, args.session_id) if args.session_id else None
    if args.dry_run:
        if args.watch:
            wait_for_compositor(desktop)
        if desktop.journal.exists():
            log("An earlier transaction is pending. Use --recover before applying changes.")
        if args.init:
            initialize(desktop, args)
        elif args.watch:
            watch(desktop, args)
        else:
            apply(desktop, args)
        return
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_fd, _ = open_owned(STATE / "lock", os.O_CREAT | os.O_RDWR)
    with os.fdopen(lock_fd, "r+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("Another nemo-grid-compensator process is running.") from error
        if args.watch:
            wait_for_compositor(desktop)
        desktop.recover()
        if args.recover:
            log("No interrupted transaction remains.")
            return
        try:
            if args.watch:
                if args.initialize:
                    bootstrap_initialization(desktop, args)
                watch(desktop, args)
            elif args.init:
                initialize(desktop, args)
            else:
                apply(desktop, args)
        except UnsafeRecovery:
            raise
        except (KeyboardInterrupt, RuntimeError, OSError, GLib.Error, subprocess.SubprocessError):
            if desktop.journal.exists() and not desktop.ending and not args.watch:
                try:
                    desktop.recover()
                except UnsafeRecovery:
                    raise
                except (RuntimeError, OSError, GLib.Error, subprocess.SubprocessError) as error:
                    log(f"Recovery pending: {error}")
            raise


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (UnsafeRecovery, Unsupported) as error:
        log(f"nemo-grid-compensator: {error}")
        sys.exit(RECOVERY_REQUIRED)
    except (OSError, ValueError, RuntimeError, configparser.Error, GLib.Error, subprocess.SubprocessError) as error:
        sys.exit(f"nemo-grid-compensator: {error}")
